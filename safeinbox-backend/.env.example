# Copy this file to .env (same folder) for local development: `python app.py` reads it automatically.

# OAuth Web client ID from Google Cloud Console (same value as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated Google accounts that get the admin role (model retraining, statistics)
ADMIN_EMAILS=you@gmail.com

# MongoDB. If it can't be reached, the backend falls back to an in-memory database (data lost on restart).
# Installed MongoDB: port 27017. MongoDB from `docker compose up -d mongo`: use port 27018.
MONGO_URI=mongodb://localhost:27017/safeinbox

# Optional: leave empty and keys are generated and saved in ./instance on first start.
# DATA_ENCRYPTION_KEY = base64-encoded 32-byte key used for AES-256 encryption of stored emails.
DATA_ENCRYPTION_KEY=
SECRET_KEY=

# Optional settings
# DATA_RETENTION_DAYS=30
# SESSION_MAX_AGE_SECONDS=28800
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
