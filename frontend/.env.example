# Copy to .env for local development (on Vercel, set these under Project Settings -> Environment Variables).

# OAuth Web client ID from Google Cloud Console. Authorized JavaScript origins must include
# http://localhost:5173 (npm run dev), http://localhost:3000 (Docker) and your Vercel address.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Backend address. Leave empty locally/in Docker (requests go to /api on the same site).
# On Vercel: the Render URL, e.g. https://safeinbox-backend.onrender.com
VITE_API_BASE_URL=

# Optional contact email shown on the Privacy Policy and Terms pages
VITE_SUPPORT_EMAIL=

# Optional public address used in link previews (social image). On Vercel it's detected automatically.
VITE_SITE_URL=

# Optional: where the dev server forwards /api requests (default http://127.0.0.1:5000)
# VITE_BACKEND_URL=http://127.0.0.1:5000
