# Copy to ci/jenkins/.env (git-ignored) before `docker compose up -d --build`.

# Jenkins login created on first start
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=choose-a-strong-password

# Google OAuth client ID (stored in Jenkins as the `safeinbox-google-client-id` credential)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Accounts that get the SafeInbox admin role in deployed builds
SAFEINBOX_ADMIN_EMAILS=you@gmail.com

# Repository and branch the pipeline builds
SAFEINBOX_REPO_URL=https://github.com/ritheshvreddy/SafeInbox.git
SAFEINBOX_BRANCH=main
