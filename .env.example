# Settings for `docker compose` and Jenkins deployments. Copy to `.env` (git-ignored).

# OAuth Web client ID (Google Cloud Console). Add http://localhost:3000 to its Authorized JavaScript origins.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google accounts with the admin role (comma-separated)
ADMIN_EMAILS=you@gmail.com

# Optional - generated automatically and stored in the backend-instance volume if left empty.
# To set your own:  python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
SECRET_KEY=

# Days before analysed emails are deleted automatically
DATA_RETENTION_DAYS=30
